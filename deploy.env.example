# Easier path: `bash deploy.sh init` walks through discovery + prompts and writes deploy.env for you.
# Manual path: copy this file to deploy.env and fill in every value. deploy.env is git-ignored.
# deploy.sh fails fast if any REQUIRED variable is unset or empty.

# ---- Stack identity ------------------------------------------------------
NAME_PREFIX=claude-gateway                                # REQUIRED. Threaded through every user-visible resource name (secrets, bucket, ALB, TG, RDS, cluster, service, task family, log groups, dashboard). Use a different prefix (e.g. claude-gateway-test) to run a parallel stack in the same account+region. Max 19 chars, lowercase alphanumeric + hyphens.
# GW_STACK=claude-apps-gateway                            # OPTIONAL. CloudFormation stack name. Defaults to $NAME_PREFIX if unset. Set explicitly if migrating from an older deploy that used a different stack name.

# ---- AWS target ----------------------------------------------------------
REGION=us-east-1                                          # REQUIRED. Region for gateway stack + VPN stack.
VPC_ID=vpc-xxxxxxxx                                       # REQUIRED. Existing VPC id. Must give the internal ALB private IPs.
VPC_CIDR=10.0.0.0/16                                      # REQUIRED. CIDR of the VPC above. Used for trusted_proxies + VPN target CIDR.
SUBNET_A=subnet-aaaaaaaa                                  # REQUIRED. First subnet (ALB + tasks + RDS + Client VPN).
SUBNET_B=subnet-bbbbbbbb                                  # REQUIRED. Second subnet in a different AZ.
CERT_ARN=arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx  # REQUIRED. ACM cert ARN. SAN must cover HOSTNAME_FQDN.
ZONE_ID=Zxxxxxxxxxxxxx                                    # REQUIRED. Route 53 PRIVATE hosted zone id (public zones leak internal ALB IPs to public DNS).
HOSTNAME_FQDN=claude-gateway.internal.example.com         # REQUIRED. Gateway FQDN. Must resolve to a private IP (CLI /login requires it).
IMAGE_URI=123456789012.dkr.ecr.us-east-1.amazonaws.com/claude-gateway:v4  # REQUIRED. Gateway container image URI in ECR.

# ---- OIDC IdP (Okta / Entra / Auth0 / etc.) ------------------------------
OIDC_ISSUER=https://login.example.com                     # REQUIRED. Must serve /.well-known/openid-configuration.
OIDC_CLIENT_ID=                                           # REQUIRED. From your IdP app (confidential web app).
OIDC_CLIENT_SECRET=                                       # REQUIRED. Passed via CFN NoEcho parameter into Secrets Manager.
EMAIL_DOMAIN=example.com                                  # REQUIRED. Allowed email domain for OIDC sign-in.
ADMIN_GROUP=claude-gateway-admins                         # REQUIRED. IdP group whose members can manage spend limits via SSO.

# ---- Upstream / dependencies --------------------------------------------
BEDROCK_REGION=us-east-1                                  # REQUIRED. Region for Bedrock InvokeModel calls.
OTEL_COLLECTOR_TAG=v0.49.0                                # REQUIRED. Pinned ADOT collector image tag. Do not use :latest in production.

# ---- VPN (optional) ------------------------------------------------------
DEPLOY_VPN=no                                             # yes|no. If yes, `deploy.sh all` also runs vpn-setup.sh.
